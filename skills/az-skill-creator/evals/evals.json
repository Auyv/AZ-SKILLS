{
  "skill_name": "az-skill-creator",
  "version": "2.0.0",
  "evals": [
    {
      "id": 1,
      "category": "normal",
      "description": "正常创建技能流程",
      "prompt": "创建一个技能，用于自动整理会议纪要",
      "expected_output": "技能目录结构完整，包含 SKILL.md、MANUAL.md、evals/evals.json",
      "criteria": [
        "skill_name 符合命名规范",
        "inputs.required 包含 user_intent",
        "outputs 包含 skill_md 和 manual_md",
        "errors 包含至少 3 个错误码",
        "evals.json 包含至少 5 个测试用例"
      ],
      "pass_score": 5
    },
    {
      "id": 2,
      "category": "normal",
      "description": "优化现有技能",
      "prompt": "优化 core-dump-analyzer 技能，添加对 ARM64 的支持",
      "expected_output": "在现有技能基础上扩展 inputs/outputs/errors",
      "criteria": [
        "inputs 新增 architecture 可选字段",
        "outputs 新增 arm64_analysis_report",
        "errors 新增 ERR_ARCH_UNSUPPORTED",
        "保留原有功能不被破坏"
      ],
      "pass_score": 4
    },
    {
      "id": 3,
      "category": "error",
      "description": "技能名称非法",
      "prompt": "创建一个技能，名字叫 my skill (有问题)",
      "expected_behavior": "error",
      "expected_error_code": "ERR_INVALID_NAME",
      "criteria": [
        "返回错误状态",
        "错误码为 ERR_INVALID_NAME",
        "提示正确的命名规范"
      ],
      "pass_score": 3
    },
    {
      "id": 4,
      "category": "error",
      "description": "技能目录已存在",
      "prompt": "创建名为 core-dump-analyzer 的技能",
      "expected_behavior": "error",
      "expected_error_code": "ERR_SKILL_EXISTS",
      "criteria": [
        "返回错误状态",
        "错误码为 ERR_SKILL_EXISTS",
        "提示覆盖或重命名选项"
      ],
      "pass_score": 3
    },
    {
      "id": 5,
      "category": "error",
      "description": "测试用例为空",
      "prompt": "创建一个技能，只有一个空空的框架，不要测试用例",
      "expected_behavior": "warning",
      "expected_error_code": "ERR_EMPTY_EVALS",
      "criteria": [
        "警告提示 evals.json 为空",
        "自动生成默认测试用例",
        "或提示用户补充"
      ],
      "pass_score": 3
    },
    {
      "id": 6,
      "category": "normal",
      "description": "从对话上下文创建技能",
      "prompt": "创建一个技能，把我们之前做的那个图片格式转换的过程总结一下",
      "expected_output": "技能名称和描述从对话中提取",
      "criteria": [
        "正确识别对话主题",
        "提取触发关键词",
        "inputs.optional.dialog_context 被使用"
      ],
      "pass_score": 3
    },
    {
      "id": 7,
      "category": "error",
      "description": "缺少必需输入",
      "prompt": "创建一个技能",
      "expected_behavior": "error",
      "expected_error_code": "ERR_INVALID_INPUT",
      "criteria": [
        "返回错误状态",
        "错误码为 ERR_INVALID_INPUT",
        "提示缺少 user_intent 或 trigger_phrase"
      ],
      "pass_score": 3
    }
  ]
}
