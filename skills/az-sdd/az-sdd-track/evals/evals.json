{
  "skill_name": "az-sdd-track",
  "version": "4.1.0",
  "evals": [
    {
      "id": 1,
      "category": "normal",
      "description": "查看项目状态",
      "prompt": "/az-sdd-track",
      "expected_output": "以 STATUS 为入口显示当前进度",
      "criteria": [
        "显示状态分布",
        "显示反馈和阻塞",
        "不复制完整规范"
      ],
      "pass_score": 3
    },
    {
      "id": 2,
      "category": "normal",
      "description": "dry-run 重建索引",
      "prompt": "/az-sdd-track rebuild --dry-run",
      "expected_output": "显示将更新的自动区块但不写文件",
      "criteria": [
        "dry_run 为 true",
        "列出变更路径",
        "工作区无变化"
      ],
      "pass_score": 3
    },
    {
      "id": 3,
      "category": "normal",
      "description": "归档已验收 v4 change",
      "prompt": "/az-sdd-track archive CHG-0001",
      "expected_output": "先 dry-run，确认后合并 baseline 并保留归档和备份",
      "criteria": [
        "归档前通过门禁",
        "baseline 合并可追溯",
        "失败自动回滚"
      ],
      "pass_score": 3
    },
    {
      "id": 4,
      "category": "error",
      "description": "项目未初始化",
      "prompt": "/az-sdd-track，但没有 az-sdd/",
      "expected_behavior": "error",
      "expected_error_code": "ERR_PROJECT_NOT_INITIALIZED",
      "criteria": [
        "返回指定错误码",
        "不伪造进度",
        "建议初始化"
      ],
      "pass_score": 3
    },
    {
      "id": 5,
      "category": "error",
      "description": "状态索引冲突",
      "prompt": "/az-sdd-track，STATUS 与 SPEC 不一致",
      "expected_behavior": "error",
      "expected_error_code": "ERR_ARTIFACT_CONFLICT",
      "criteria": [
        "列出冲突路径",
        "不直接覆盖",
        "建议 analyze/rebuild"
      ],
      "pass_score": 3
    }
  ]
}
