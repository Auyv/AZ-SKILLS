{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://az-sdd.local/contracts/result.schema.json",
  "title": "AZ-SDD Skill Result",
  "type": "object",
  "required": ["status", "timestamp", "skill", "data", "warnings", "error", "next_action"],
  "properties": {
    "status": {
      "type": "string",
      "enum": ["success", "warning", "error", "needs_input"]
    },
    "timestamp": {
      "type": "string",
      "format": "date-time"
    },
    "skill": {
      "type": "string",
      "pattern": "^az-sdd-[a-z-]+$"
    },
    "data": {
      "type": "object"
    },
    "warnings": {
      "type": "array",
      "items": {"type": "string"}
    },
    "error": {
      "oneOf": [
        {"type": "null"},
        {
          "type": "object",
          "required": ["code", "message", "recovery"],
          "properties": {
            "code": {"type": "string", "pattern": "^ERR_[A-Z0-9_]+$"},
            "message": {"type": "string"},
            "recovery": {"type": "string"}
          },
          "additionalProperties": false
        }
      ]
    },
    "next_action": {
      "oneOf": [
        {"type": "null"},
        {
          "type": "object",
          "required": ["skill", "reason"],
          "properties": {
            "skill": {"type": "string"},
            "reason": {"type": "string"},
            "prompt": {"type": "string"}
          },
          "additionalProperties": false
        }
      ]
    }
  },
  "additionalProperties": false
}
