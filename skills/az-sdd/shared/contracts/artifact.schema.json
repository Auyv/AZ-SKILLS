{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://az-sdd.local/contracts/artifact.schema.json",
  "title": "AZ-SDD Artifact Metadata",
  "type": "object",
  "required": ["id", "kind", "status", "path"],
  "properties": {
    "id": {
      "type": "string",
      "pattern": "^(?:[0-9]{4}|FB-[0-9]{4}-[0-9]{3,4}|[A-Z][A-Z0-9]*(?:-[A-Z0-9]+)+)$"
    },
    "kind": {
      "type": "string",
      "enum": ["spec", "arch", "coding", "test", "feedback", "status", "report", "baseline_spec", "change", "proposal", "spec_delta", "design", "tasks", "evidence", "acceptance", "archive"]
    },
    "status": {
      "type": "string"
    },
    "path": {
      "type": "string",
      "minLength": 1
    },
    "links": {
      "type": "array",
      "items": {"type": "string"}
    },
    "evidence": {
      "type": "array",
      "items": {"type": "string"}
    },
    "updated_at": {
      "type": "string",
      "format": "date-time"
    },
    "format_version": {
      "type": "integer",
      "enum": [3, 4]
    },
    "sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    }
  },
  "additionalProperties": false
}
