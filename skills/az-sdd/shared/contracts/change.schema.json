{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://az-sdd.local/contracts/change.schema.json",
  "title": "AZ-SDD v4 Change Metadata",
  "type": "object",
  "required": ["change_id", "title", "status", "created_at", "risk", "operations"],
  "properties": {
    "change_id": {
      "type": "string",
      "pattern": "^[A-Z][A-Z0-9]*(?:-[A-Z0-9]+)+$"
    },
    "title": {"type": "string", "minLength": 1},
    "status": {"type": "string", "enum": ["proposed", "ready", "archived"]},
    "created_at": {"type": "string", "format": "date-time"},
    "archived_at": {"type": "string", "format": "date-time"},
    "risk": {
      "type": "object",
      "required": ["factors", "gates", "path"],
      "properties": {
        "factors": {
          "type": "array",
          "uniqueItems": true,
          "items": {"type": "string", "enum": ["multi_module", "public_api", "data_migration", "new_dependency", "security", "hardware", "deployment", "irreversible", "insufficient_tests", "unknown_scope", "user_experience"]}
        },
        "gates": {"type": "object"},
        "path": {"type": "string", "enum": ["fast", "expanded"]}
      },
      "additionalProperties": false
    },
    "operations": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["operation", "target", "base_sha256"],
        "properties": {
          "operation": {"type": "string", "enum": ["ADDED", "MODIFIED", "REMOVED"]},
          "target": {"type": "string", "pattern": "^specs/[A-Za-z0-9._-]+\\.spec\\.md$"},
          "base_sha256": {"type": "string", "pattern": "^(?:[0-9a-f]{64}|-)$"}
        },
        "additionalProperties": false
      }
    }
  },
  "additionalProperties": false
}
