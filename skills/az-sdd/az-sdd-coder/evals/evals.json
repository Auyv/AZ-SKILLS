      "pass_score": 3
    },
    {
      "id": 5,
      "category": "error",
      "description": "自动化测试失败",
      "prompt": "/az-sdd-coder 0001，测试失败",
      "expected_behavior": "error",
      "expected_error_code": "ERR_TEST_FAILED",
