{
  "page_numbers": [
    "^\\s*Page\\s+\\d+\\s*$",
    "^\\s*-\\s*\\d+\\s*-\\s*$",
    "^\\s*第\\s*\\d+\\s*页\\s*$",
    "^\\s*\\d+\\s*/\\s*\\d+\\s*$",
    "^\\s*\\-\\s*\\d+\\s*\\-\\s*$",
    "^\\s*\\[\\s*\\d+\\s*\\]\\s*$"
  ],
  "watermarks": [
    "(?i)confidential",
    "(?i)draft",
    "(?i)do not distribute",
    "(?i)internal use only",
    "仅供参考",
    "内部资料",
    "机密"
  ],
  "headers_footers": {
    "min_repeat_ratio": 0.5,
    "max_line_length": 120,
    "skip_patterns": [
      "^\\s*$",
      "^\\s*#{1,6}\\s"
    ]
  },
  "code_indicators": [
    "^\\s*(def|class|import|from|if|for|while|return|try|except|with|async|await)\\b",
    "^\\s*(function|var|let|const|export|import|return|if|for|while|try|catch)\\b",
    "^\\s*(public|private|protected|static|void|int|String|bool)\\b",
    "\\{$",
    "\\}$",
    "^\\s*//",
    "^\\s*/\\*",
    "^\\s*\\*",
    "=>\\s*\\{",
    "^\\s*@\\w+"
  ],
  "json_indicators": [
    "^\\s*\\{",
    "^\\s*\\}",
    "^\\s*\"",
    "\"\\s*:\\s*"
  ],
  "extra_whitespace": {
    "max_consecutive_blank_lines": 2
  }
}
