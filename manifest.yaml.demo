# AZ-SKILLS 本地 manifest 示例
#
# 首次使用：复制为 manifest.yaml，再按本机平台、路径和需要加载的技能修改。
# manifest.yaml 仅在本地维护，不提交到仓库；不要把用户路径或账号写回本文件。

last_sync: null
agent_targets:
- aggregate_subdir: ''
  enabled: true
  name: codex
  path: ~/.codex/skills
  skills:
  - az-skill-creator
  - az-ai-handover-workflow
  - hc-ctp-work-ready-workflow
- aggregate_subdir: ''
  enabled: true
  name: opencode
  path: ~/.config/opencode/skills
  skills:
  - az-skill-creator
  - az-ai-handover-workflow
  - hc-ctp-work-ready-workflow
- aggregate_subdir: ''
  enabled: false
  name: claude_code
  path: ~/.claude/skills
  skills:
  - az-skill-creator
- aggregate_subdir: ''
  enabled: false
  name: hermes
  path: ~/AppData/Local/hermes/skills
  skills:
  - az-skill-creator
- aggregate_subdir: ''
  enabled: false
  name: openclaw
  path: ~/.openclaw/skills
  skills:
  - az-skill-creator
- aggregate_subdir: ''
  enabled: false
  name: pi
  path: ~/.pi/agent/skills
  exclude: []
