{
  "skill_name": "azkits-add-tool",
  "version": "1.0.0",
  "evals": [
    {
      "id": 1,
      "category": "normal",
      "description": "向空配置添加 PowerShell 工具",
      "prompt": "把 scripts/device_init.ps1 添加到 toolbox.yaml，别名 device-init，名称设备初始化，说明初始化设备",
      "expected_output": "追加包含全部必填字段的 powershell 工具描述",
      "criteria": ["scripts 从空列表变为条目列表", "路径保持相对配置目录", "生成恢复备份"],
      "pass_score": 3
    },
    {
      "id": 2,
      "category": "normal",
      "description": "添加带参数与环境变量的 Python 工具",
      "prompt": "添加 demo.py，固定参数 5，环境变量 MODE=test，工作目录 scripts",
      "expected_output": "args、env、cwd 作为结构化 YAML 字段写入",
      "criteria": ["不拼接自由命令", "args 为字符串数组", "env 为字符串映射"],
      "pass_score": 3
    },
    {
      "id": 3,
      "category": "normal",
      "description": "添加禁用的 EXE 工具",
      "prompt": "添加 tools/check.exe，但先设为禁用",
      "expected_output": "生成 type exe 且 enabled false 的条目",
      "criteria": ["type 为 exe", "enabled 为 false", "保留说明字段"],
      "pass_score": 3
    },
    {
      "id": 4,
      "category": "error",
      "description": "配置文件不存在",
      "prompt": "向 missing.yaml 添加 demo 工具",
      "expected_behavior": "error",
      "expected_error_code": "ERR_FILE_NOT_FOUND",
      "criteria": ["返回错误状态", "不创建伪配置", "建议先创建配置"],
      "pass_score": 3
    },
    {
      "id": 5,
      "category": "error",
      "description": "工具 ID 重复",
      "prompt": "向已有 id=device-init 的配置再次添加同 ID 工具",
      "expected_behavior": "error",
      "expected_error_code": "ERR_DUPLICATE_ID",
      "criteria": ["不修改配置", "指出重复 ID", "保留原条目"],
      "pass_score": 3
    },
    {
      "id": 6,
      "category": "error",
      "description": "别名忽略大小写后重复",
      "prompt": "已有 alias=Demo，再添加 alias=demo",
      "expected_behavior": "error",
      "expected_error_code": "ERR_DUPLICATE_ALIAS",
      "criteria": ["按大小写不敏感比较", "不修改配置", "返回明确错误码"],
      "pass_score": 3
    },
    {
      "id": 7,
      "category": "error",
      "description": "非法工具类型",
      "prompt": "添加 type=javascript 的工具",
      "expected_behavior": "error",
      "expected_error_code": "ERR_INVALID_TYPE",
      "criteria": ["拒绝未知类型", "列出支持边界", "不修改配置"],
      "pass_score": 3
    }
  ]
}
